<%- include('../partials/header') %>

<h1 class="h3 mb-3"><%= title %></h1>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
    </ul>
  </div>
<% } %>

<%
  let dateValue = '';
  if (entry && entry.entryDate) {
    const d = new Date(entry.entryDate);
    if (!isNaN(d)) dateValue = d.toISOString().slice(0, 10);
  }
%>

<datalist id="budgetCategories">
  <option value="Supplies">
  <option value="Food">
  <option value="Transportation">
  <option value="Printing">
  <option value="Event Expenses">
  <option value="Membership Fees">
  <option value="Miscellaneous">
</datalist>

<form method="post" action="<%= entry && entry.id ? '/officer/budget/' + entry.id : '/officer/budget' %>" class="card card-body shadow-sm">
  <div class="row g-3">
    <div class="col-md-3">
      <label class="form-label">Type</label>
      <select name="type" class="form-select">
        <option value="income" <%= entry && entry.type === 'income' ? 'selected' : '' %>>Income</option>
        <option value="expense" <%= !entry || entry.type === 'expense' ? 'selected' : '' %>>Expense</option>
      </select>
    </div>
    <div class="col-md-3">
      <label class="form-label">Amount (₱)</label>
      <input type="number" step="0.01" min="0.01" name="amount" class="form-control" value="<%= (entry && entry.amount) || '' %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">Date</label>
      <input type="date" name="entryDate" class="form-control" value="<%= dateValue %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">Category</label>
      <input type="text" name="category" class="form-control" list="budgetCategories" value="<%= (entry && entry.category) || '' %>" required>
    </div>
    <div class="col-md-8">
      <label class="form-label">Description</label>
      <input type="text" name="description" class="form-control" value="<%= (entry && entry.description) || '' %>" required>
    </div>
    <div class="col-md-4">
      <label class="form-label">Related Event (optional)</label>
      <select name="eventId" class="form-select">
        <option value="">None</option>
        <% events.forEach(function(ev) { %>
          <option value="<%= ev.id %>" <%= entry && Number(entry.eventId) === ev.id ? 'selected' : '' %>><%= ev.name %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary" type="submit">Save</button>
    <a href="/officer/budget" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
