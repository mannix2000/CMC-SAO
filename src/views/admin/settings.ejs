<%- include('../partials/header') %>

<h1 class="h3 mb-3">Settings</h1>

<% if (saved) { %>
  <div class="alert alert-success py-2">Settings saved.</div>
<% } %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
    </ul>
  </div>
<% } %>

<form method="post" action="/admin/settings" enctype="multipart/form-data" class="card card-body shadow-sm">
  <div class="mb-3">
    <label class="form-label">System Name</label>
    <input type="text" name="systemName" class="form-control" value="<%= settings.systemName %>" required maxlength="80">
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <label class="form-label">Absent Fine (₱)</label>
      <input type="number" step="0.01" min="0" name="absentFee" class="form-control" value="<%= Number(settings.absentFee) %>" required>
      <div class="form-text">Automatically charged when an officer marks a student Absent. Set to 0 to disable.</div>
    </div>
    <div class="col-md-6">
      <label class="form-label">Late Fine (₱)</label>
      <input type="number" step="0.01" min="0" name="lateFee" class="form-control" value="<%= Number(settings.lateFee) %>" required>
      <div class="form-text">Automatically charged when an officer marks a student Late. Set to 0 to disable.</div>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label">Logo</label>
    <div class="mb-2">
      <% if (settings.logoPath) { %>
        <img src="<%= settings.logoPath %>" alt="Current logo" style="max-height: 60px;" class="d-block mb-2 border rounded p-1 bg-white">
        <div class="form-check">
          <input type="checkbox" name="removeLogo" class="form-check-input" id="removeLogo">
          <label class="form-check-label" for="removeLogo">Remove current logo</label>
        </div>
      <% } else { %>
        <p class="text-muted small mb-1">No logo set.</p>
      <% } %>
    </div>
    <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control">
  </div>

  <div class="mb-3">
    <label class="form-label">Background Image</label>
    <div class="mb-2">
      <% if (settings.backgroundImagePath) { %>
        <img src="<%= settings.backgroundImagePath %>" alt="Current background" style="max-height: 100px;" class="d-block mb-2 border rounded">
        <div class="form-check">
          <input type="checkbox" name="removeBackground" class="form-check-input" id="removeBackground">
          <label class="form-check-label" for="removeBackground">Remove current background</label>
        </div>
      <% } else { %>
        <p class="text-muted small mb-1">No background image set (using default light background).</p>
      <% } %>
    </div>
    <input type="file" name="backgroundImage" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control">
  </div>

  <button class="btn btn-primary" type="submit">Save Settings</button>
</form>

<%- include('../partials/footer') %>
