<%- include('../partials/header') %>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Report: <%= event.name %></h1>
</div>

<p class="text-muted"><%= event.eventDate.toDateString() %> &middot; <%= event.type %></p>

<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="student-tab-btn" data-bs-toggle="tab" data-bs-target="#student-tab" type="button" role="tab" aria-controls="student-tab" aria-selected="true">
      Student Attendance
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="faculty-tab-btn" data-bs-toggle="tab" data-bs-target="#faculty-tab" type="button" role="tab" aria-controls="faculty-tab" aria-selected="false">
      Faculty &amp; Staff Attendance
    </button>
  </li>
</ul>

<div class="tab-content">
  <div class="tab-pane fade show active" id="student-tab" role="tabpanel" aria-labelledby="student-tab-btn">
    <div class="d-flex flex-wrap gap-2 justify-content-end mb-2">
      <a href="/admin/events/<%= event.id %>/report/export" class="btn btn-outline-primary btn-sm">Export CSV</a>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-striped bg-white">
        <thead>
          <tr>
            <th>Student #</th><th>Name</th><th>Course</th><th>Section</th>
            <% if (event.requiresSsg) { %>
              <th>SSG Status</th><th>SSG Morning (In / Out)</th><th>SSG Afternoon (In / Out)</th>
            <% } %>
            <% if (event.requiresNstp) { %>
              <th>NSTP Status</th><th>NSTP Morning (In / Out)</th><th>NSTP Afternoon (In / Out)</th>
            <% } %>
            <th>Overall</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(s) { %>
            <% const checks = checksByStudentId.get(s.id); %>
            <% const overall = computeOverallStatus(event, checks); %>
            <% const ssg = checks && checks.ssg; %>
            <% const nstp = checks && checks.nstp; %>
            <tr>
              <td><%= s.studentNumber %></td>
              <td><%= s.lastName %>, <%= s.firstName %></td>
              <td><%= s.course %></td>
              <td><%= s.section %></td>
              <% if (event.requiresSsg) { %>
                <td><%= (ssg && ssg.status) || 'unmarked' %></td>
                <td class="small">
                  In: <%= ssg && ssg.timeInAm ? formatClockTime(ssg.timeInAm) : '—' %>
                  &middot;
                  Out: <%= ssg && ssg.timeOutAm ? formatClockTime(ssg.timeOutAm) : '—' %>
                </td>
                <td class="small">
                  In: <%= ssg && ssg.timeInPm ? formatClockTime(ssg.timeInPm) : '—' %>
                  &middot;
                  Out: <%= ssg && ssg.timeOutPm ? formatClockTime(ssg.timeOutPm) : '—' %>
                </td>
              <% } %>
              <% if (event.requiresNstp) { %>
                <td><%= (nstp && nstp.status) || 'unmarked' %></td>
                <td class="small">
                  In: <%= nstp && nstp.timeInAm ? formatClockTime(nstp.timeInAm) : '—' %>
                  &middot;
                  Out: <%= nstp && nstp.timeOutAm ? formatClockTime(nstp.timeOutAm) : '—' %>
                </td>
                <td class="small">
                  In: <%= nstp && nstp.timeInPm ? formatClockTime(nstp.timeInPm) : '—' %>
                  &middot;
                  Out: <%= nstp && nstp.timeOutPm ? formatClockTime(nstp.timeOutPm) : '—' %>
                </td>
              <% } %>
              <td>
                <span class="badge bg-<%= overall === 'present' ? 'success' : overall === 'absent' ? 'danger' : 'secondary' %>">
                  <%= overall %>
                </span>
              </td>
            </tr>
          <% }); %>
          <% if (students.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted">No students on record.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="tab-pane fade" id="faculty-tab" role="tabpanel" aria-labelledby="faculty-tab-btn">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
      <p class="text-muted small mb-0">Checked by NSTP only; not subject to fines.</p>
      <a href="/admin/events/<%= event.id %>/report/faculty-export" class="btn btn-outline-primary btn-sm">Export CSV</a>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-striped bg-white">
        <thead>
          <tr><th>Name</th><th>Department</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% facultyList.forEach(function(f) { %>
            <% const fCheck = facultyChecksById.get(f.id); %>
            <tr>
              <td><%= f.lastName %>, <%= f.firstName %></td>
              <td><%= f.department %></td>
              <td>
                <% if (fCheck) { %>
                  <span class="badge bg-<%= fCheck.status === 'present' ? 'success' : fCheck.status === 'absent' ? 'danger' : 'secondary' %>">
                    <%= fCheck.status %>
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary">unmarked</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
          <% if (facultyList.length === 0) { %>
            <tr><td colspan="3" class="text-center text-muted">No faculty/staff on record.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
