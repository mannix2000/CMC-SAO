<%- include('../partials/header') %>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Budget &amp; Expenses</h1>
  <div class="d-flex flex-wrap gap-2">
    <a href="/admin/budget/export<%= org ? '?org=' + org : '' %>" class="btn btn-outline-secondary btn-sm">Export CSV</a>
    <a href="/admin/budget/new" class="btn btn-primary btn-sm">New Entry</a>
  </div>
</div>

<div class="btn-group btn-group-sm mb-4" role="group">
  <a href="/admin/budget" class="btn btn-outline-primary <%= !org ? 'active' : '' %>">All</a>
  <a href="/admin/budget?org=ssg" class="btn btn-outline-primary <%= org === 'ssg' ? 'active' : '' %>">SSG</a>
  <a href="/admin/budget?org=nstp" class="btn btn-outline-primary <%= org === 'nstp' ? 'active' : '' %>">NSTP</a>
</div>

<div class="row g-3 mb-4">
  <% ['ssg', 'nstp'].forEach(function(o) { %>
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="h6 text-muted"><%= o.toUpperCase() %></h2>
          <div class="row text-center">
            <div class="col-4">
              <div class="small text-muted">Income</div>
              <div class="text-success fw-bold">₱<%= summaries[o].income.toFixed(2) %></div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Expenses</div>
              <div class="text-danger fw-bold">₱<%= summaries[o].expense.toFixed(2) %></div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Balance</div>
              <div class="fw-bold <%= summaries[o].balance < 0 ? 'text-danger' : '' %>">₱<%= summaries[o].balance.toFixed(2) %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<div class="table-responsive">
  <table class="table table-sm table-striped bg-white">
    <thead>
      <tr><th>Date</th><th>Org</th><th>Type</th><th>Category</th><th>Description</th><th>Event</th><th class="text-end">Amount</th><th></th></tr>
    </thead>
    <tbody>
      <% entries.forEach(function(e) { %>
        <tr>
          <td><%= e.entryDate.toISOString().slice(0, 10) %></td>
          <td><span class="badge bg-secondary"><%= e.orgRole.toUpperCase() %></span></td>
          <td><span class="badge bg-<%= e.type === 'income' ? 'success' : 'danger' %>"><%= e.type %></span></td>
          <td><%= e.category %></td>
          <td><%= e.description %></td>
          <td><%= e.event ? e.event.name : '' %></td>
          <td class="text-end">₱<%= Number(e.amount).toFixed(2) %></td>
          <td class="text-end">
            <a href="/admin/budget/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
            <form method="post" action="/admin/budget/<%= e.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this entry?');">
              <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (entries.length === 0) { %>
        <tr><td colspan="8" class="text-center text-muted">No budget entries yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
