# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cmc_sao_attendance?schema=public"

# Session secret (use a long random string in production)
SESSION_SECRET="change-this-to-a-random-secret"

# JWT secret for the mobile API (use a different long random string in production)
JWT_SECRET="change-this-to-a-different-random-secret"
JWT_EXPIRES_IN="30d"

# Port the app listens on
PORT=3000

# Initial admin account created by prisma/seed.js
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
